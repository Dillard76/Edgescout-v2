# EdgeScout v2 — Python agent environment
# Copy to .env (never commit .env) and fill in your own values.
# Only Pinecone needs a key for live retrieval — CoinGecko and GoPlus
# are free with no key. Nansen is paid; leave it unset for now.

# Pinecone (free tier: one serverless index at https://www.pinecone.io/)
# Live retrieval + the TS client in src/services/pinecone.ts use these.
PINECONE_API_KEY=
PINECONE_INDEX_NAME="edgescout-v2-memory"
PINECONE_ENVIRONMENT="us-east-1"

# Nansen (paid API — optional; valuation uses live CoinGecko prices until set)
# NANSEN_API_KEY=
# NANSEN_API_KEY_2=
# NANSEN_API_KEY_3=

# Gemini (used by the TS app for LLM calls)
# GEMINI_API_KEY=
