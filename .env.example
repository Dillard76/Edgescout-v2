# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optimism OP Stack (Chain ID: 10) Configuration
OPTIMISM_RPC_URL="https://mainnet.optimism.io"
PRIVATE_KEY="0x_YOUR_OPTIMISM_DEPLOYER_PRIVATE_KEY"
CONTRACT_ADDRESS="0x_DEPLOYED_EDGESCOUT_ACQUISITION_V2_ADDRESS"
VISION_PRICER_ORACLE_ADDRESS="0x_VISION_PRICER_ORACLE_PUBLIC_ADDRESS"
SCAN_NODE_RELAYER_ADDRESS="0x_SCAN_NODE_RELAYER_PUBLIC_ADDRESS"
RELAYER_PRIVATE_KEY="0x_SCAN_NODE_RELAYER_PRIVATE_KEY"

# Pinecone 3072-D Vector Memory Settings
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX_NAME="edgescout-v2-memory"
PINECONE_ENVIRONMENT="us-east-1"

# Nansen v1 Smart Money Multi-Key Pool (Auto-Rotating on 429 Rate Limits & 401s)
NANSEN_API_KEY="your_primary_nansen_api_key"
NANSEN_API_KEY_2="your_secondary_nansen_api_key"
NANSEN_API_KEY_3="your_tertiary_nansen_api_key"

# Firebase Client Configuration (Optional if firebase-applet-config.json is used)
VITE_FIREBASE_API_KEY="your_firebase_web_api_key"
VITE_FIREBASE_APP_ID="your_firebase_app_id"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0593936359"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0593936359.firebaseapp.com"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-edgescoutv2auton-32c7e276-44b0-4aa9-92d8-b9cfd658a012"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0593936359.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="382869441502"
